# 复制为 .env 后填写；留空的项走 worker.mjs 顶部的常量默认值。
# 变量名与 Cloudflare 版完全相同，从 CF 迁移时把原来的变量/Secret 原样搬过来即可。

# 监听端口（默认 3000）
PORT=3000

# 站点的公开访问地址（可选）。放在 nginx/Caddy 等反代后面时建议填写，
# 如 https://ss.example.com；不填则按请求头自动推断。
PUBLIC_ORIGIN=

# 站点 Basic Auth（建议与 Iwara 账号能力同时启用时打开）
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Iwara 授权方式一：直接给 Token
IWARA_AUTHORIZATION=

# Iwara 授权方式二：自动登录（与上面 Token 二选一即可，Token 失效时自动登录续期）
IWARA_USERNAME=
IWARA_PASSWORD=

# 首页通知接口与新站引导（可选）
NOTICE_API_URL=
NEW_SITE_URL=

# 播放模式（proxy=经本站代理播放 / direct=直连 Iwara）
# 注意：CF 版依据 Cloudflare 当日请求数自动切 direct 的估算在 Node 上没有数据来源，
# 不会触发自动切换；需要固定直连时把这里设为 direct。
FORCE_PLAYBACK_MODE=

# ---- 可选：Cloudflare 挑战自动过盾（FlareSolverr） ----
# 本服务直连上游若被 Cloudflare 弹人机挑战（Just a moment / 403），可启用：
# 检测到挑战时自动找 FlareSolverr 取 cf_clearance + UA，注入并重试，按源缓存复用。
# 前提：FlareSolverr 必须与本服务同一台机器/同一出口 IP 部署（clearance 绑定 UA+IP）。
# 启动 FlareSolverr（Docker）：docker run -d --name flaresolverr --restart unless-stopped -p 8191:8191 ghcr.io/flaresolverr/flaresolverr:latest
# 不填 FLARESOLVERR_URL 则完全不启用，全局请求行为与原版一致。
FLARESOLVERR_URL=
# 解盾最长等待毫秒（默认 60000），可选
FLARESOLVERR_MAX_TIMEOUT=
# FlareSolverr 会话名（可选，填了会复用同一个浏览器会话解盾）
FLARESOLVERR_SESSION=
# 只对这些域名后缀启用过盾（逗号分隔，可选；如 iwara.tv；留空=全部上游）
FLARESOLVERR_HOSTS=
# 内容直取兜底（默认开）：上游对浏览器静默放行、不签发 cookie 时（如 apiq.iwara.tv），
# 直接采用 FlareSolverr 浏览器取回的正文返回（仅无 body、无 Range 的 GET）。设为 off 关闭。
FLARESOLVERR_BROWSER_FETCH=
# 指纹回放（默认 auto）：带 clearance 回放时优先用可选依赖 impit 冒充 Chrome 指纹
#（某些站点把 clearance 与 TLS 指纹绑定校验，Node 原生指纹回放会被拒）。
# auto=装了 impit 就用；on=必须用（缺失时告警）；off=只用原生 fetch 回放。
FLARESOLVERR_USE_IMPIT=
