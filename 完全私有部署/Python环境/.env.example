# 复制为 .env 后填写；Python 版与 Node 版使用相同的业务配置名。
# 系统环境变量优先于 .env；空配置默认关闭对应能力。
HOST=0.0.0.0
PORT=3000

# 站点访问认证（使用共享 Iwara 账号时建议启用）
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# 手动 Token，可带或不带 Bearer 前缀
IWARA_AUTHORIZATION=
# 自动登录；手动 Token 失效后可自动登录续期。密码保留引号内的空格。
IWARA_USERNAME=
IWARA_PASSWORD=

# 通知接口与备用站点
NOTICE_API_URL=
NOTICE_API_CACHE_TTL_SECONDS=300
NEW_SITE_URL=

# 空值默认 proxy；可强制设置 proxy / direct
FORCE_PLAYBACK_MODE=
# 可选：查询指定 Cloudflare Worker 的当日请求量。Python 服务自身不受 Workers 免费额度限制。
CF_ACCOUNT_TAG=
CF_ANALYTICS_API_TOKEN=
CF_WORKER_SCRIPT_NAME=
WORKERS_DAILY_REQUEST_LIMIT=100000
DIRECT_MODE_REMAINING_REQUESTS_THRESHOLD=100
PLAYBACK_MODE_CACHE_TTL_SECONDS=300

# 可选：同出口部署的 FlareSolverr（例：http://127.0.0.1:8191）
FLARESOLVERR_URL=
FLARESOLVERR_MAX_TIMEOUT=60000
FLARESOLVERR_SESSION=
# 逗号分隔域名后缀；留空对全部上游启用
FLARESOLVERR_HOSTS=
# 默认开启内容直取兜底；off / 0 / false 关闭
FLARESOLVERR_BROWSER_FETCH=
# auto / on / off；安装 requirements-optional.txt 后可用 Chrome 指纹回放
FLARESOLVERR_USE_CURL_CFFI=auto
# 兼容 Node 版的 FLARESOLVERR_USE_IMPIT；上面的变量非空时优先使用上面的值
# FLARESOLVERR_USE_IMPIT=auto
